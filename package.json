{
  "name": "markdown-mint",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Theme-driven Markdown to PDF and standalone HTML publishing.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=11.18.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "clean": "pnpm --recursive --if-present run clean",
    "dev": "pnpm --filter @markdown-mint/web dev",
    "dev:renderer": "pnpm --filter @markdown-mint/renderer dev",
    "dev:web": "pnpm --filter @markdown-mint/web dev",
    "docker:renderer:build": "docker build --build-arg MARKDOWN_MINT_VERSION=local --file apps/renderer/Dockerfile --tag markdown-mint-renderer:local .",
    "docker:renderer:down": "docker compose --file deploy/renderer-local-compose.yml down",
    "docker:renderer:up": "docker compose --file deploy/renderer-local-compose.yml up --build --detach",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps packages scripts eslint.config.mjs prettier.config.mjs vitest.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:web": "node scripts/e2e-web.mjs",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.13",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1"
  }
}
