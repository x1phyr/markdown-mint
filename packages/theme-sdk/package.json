{
  "name": "@markdown-mint/theme-sdk",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "markdown-mint-theme-check": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "theme:check": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
